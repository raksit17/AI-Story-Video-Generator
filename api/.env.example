HOST=127.0.0.1
PORT=3002
# May use the same PostgreSQL database as youtube-highlight-api.
# Only thumbnail_editor schema is created/modified by this project.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_highlight
# api | database | local
VIDEO_CATALOG_MODE=api
HIGHLIGHT_API_URL=http://127.0.0.1:3001/api/v1
# Required only in database mode. Prefer a SELECT-only database user.
HIGHLIGHT_DATABASE_URL=
# Use forward slashes on Windows; no need to copy your source videos.
VIDEO_SOURCE_DIR=D:/GitPoom/youtube-highlight-api/storage/sources
STORAGE_DIR=./storage
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for local use. Required when HOST is not loopback.
# Frontend sends X-API-Key for ALL endpoints, including images.
API_KEY=

# Phase 2 internal FastAPI service
REMOVAL_WORKER_URL=http://127.0.0.1:8001
REMOVAL_WORKER_KEY=
REMOVAL_TIMEOUT_MS=180000

# Story Planner: generate meaningful narration + matching SDXL visual prompts.
# Local Ollama + Qwen requires no OpenAI API key. Run: ollama pull qwen3.5:4b
# Alternative: STORY_PROVIDER=openai and configure OPENAI_API_KEY and STORY_MODEL.
STORY_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_STORY_MODEL=qwen3.5:4b
# STORY_PROVIDER=openai
# OPENAI_API_KEY=
# STORY_MODEL=gpt-4o-mini

# Phase 3: ComfyUI runs separately, normally on Windows host GPU.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Choose SDXL Base or Animagine XL 3.1 in the Storyframe Phase 01 model selector.
# Existing stories without imageModel still default to SDXL Base.
# Copy the checkpoint yourself: GitHub cannot include a 6.94 GB model.
COMFYUI_ANIMAGINE_CHECKPOINT=animagine-xl-3.1.safetensors
# API-only fallback for callers that omit imageModel (normally leave SDXL for existing stories):
# COMFYUI_IMAGE_MODEL=sdxl-base
COMFYUI_JOB_TIMEOUT_MS=900000
# Character image conditioning: IP-Adapter Plus for SDXL instead of img2img
# Requires ComfyUI_IPAdapter_plus, matching CLIP Vision and SDXL IP-Adapter models
COMFYUI_CLIP_VISION_MODEL=CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors
COMFYUI_IPADAPTER_MODEL=ip-adapter-plus_sdxl_vit-h.safetensors
COMFYUI_IPADAPTER_WEIGHT=0.70
COMFYUI_IPADAPTER_END_AT=0.85
# Legacy COMFYUI_REFERENCE_DENOISE does not apply to IP-Adapter
# MOSS Voice Studio; the API key stays server-side and is sent as X-API-Key.
MOSS_API_URL=http://127.0.0.1:8001
MOSS_API_KEY=local-dev-key
AI_QUEUE_ENABLED=true
